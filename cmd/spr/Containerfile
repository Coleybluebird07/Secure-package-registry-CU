# Build stage
FROM golang:1.25-bookworm AS builder

WORKDIR /app

ENV GOTOOLCHAIN=auto

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN go install github.com/google/oss-rebuild/cmd/oss-rebuild@latest

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/spr ./cmd/spr

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        diffoscope-minimal \
        docker.io \
        file \
        gzip \
        tar \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin spr

WORKDIR /app

COPY --from=builder /app/infra/migrations ./infra/migrations
COPY --from=builder /app/scripts ./scripts
COPY --from=builder /app/spr ./spr
COPY --from=builder /go/bin/oss-rebuild /usr/local/bin/oss-rebuild

RUN chown -R spr:spr ./spr ./infra ./scripts \
    && chmod +x ./scripts/oss-rebuild-artifact.sh \
    && chmod +x /usr/local/bin/oss-rebuild

USER spr

ENTRYPOINT ["./spr"]