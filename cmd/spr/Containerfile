# Build stage
FROM golang:1.25.6-alpine AS builder

WORKDIR /app

# Install dependencies
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/spr ./cmd/spr

# Runtime stage
FROM debian:bookworm-slim

# Install runtime tools:
# - ca-certificates for HTTPS calls
# - diffoscope for artifact diffs
# - tar/gzip/xz-utils/unzip/file for archive inspection support
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        diffoscope-minimal \
        file \
        gzip \
        tar \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin spr

WORKDIR /app

# Copy migrations
COPY --from=builder /app/infra/migrations ./infra/migrations

# Copy binary from builder
COPY --from=builder /app/spr ./spr

# Set ownership
RUN chown -R spr:spr ./spr ./infra

# Switch to non-root user
USER spr

# Run the service
ENTRYPOINT ["./spr"]