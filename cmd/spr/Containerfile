# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Allow Go to fetch a newer toolchain if a dependency requires it.
ENV GOTOOLCHAIN=auto

# Install build dependencies for Go modules fetched from GitHub.
RUN apk add --no-cache git ca-certificates build-base

# Install OSS Rebuild CLI.
RUN go install github.com/google/oss-rebuild/cmd/oss-rebuild@latest

# Install project dependencies.
COPY go.mod go.sum ./
RUN go mod download

# Copy source code.
COPY . .

# Build SPR binary.
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/spr ./cmd/spr

# Runtime stage
FROM debian:bookworm-slim

# Install runtime tools:
# - ca-certificates for HTTPS calls
# - diffoscope for artifact diffs
# - docker CLI for running OSS Rebuild Dockerfile output
# - tar/gzip/xz-utils/unzip/file for archive inspection support
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        diffoscope-minimal \
        docker.io \
        file \
        gzip \
        tar \
        unzip \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user.
RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin spr

WORKDIR /app

# Copy migrations and scripts.
COPY --from=builder /app/infra/migrations ./infra/migrations
COPY --from=builder /app/scripts ./scripts

# Copy binaries from builder.
COPY --from=builder /app/spr ./spr
COPY --from=builder /go/bin/oss-rebuild /usr/local/bin/oss-rebuild

# Set ownership and permissions.
RUN chown -R spr:spr ./spr ./infra ./scripts \
    && chmod +x ./scripts/oss-rebuild-npm.sh

# Switch to non-root user.
USER spr

# Run the service.
ENTRYPOINT ["./spr"]